{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "mtkprof",
  "version": "../package.json",
  "identifier": "com.davidbudac.mtkprof",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "mtkprof",
        "width": 1400,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "'self' http://127.0.0.1:* ipc: http://ipc.localhost",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "style-src": "'self' 'unsafe-inline'"
      },
      "devCsp": {
        "default-src": "'self'",
        "connect-src": "'self' http://127.0.0.1:* ipc: http://ipc.localhost ws://localhost:5173",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "style-src": "'self' 'unsafe-inline'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "appimage", "deb"],
    "category": "DeveloperTool",
    "shortDescription": "Oracle SQL trace analyzer",
    "longDescription": "mtkprof desktop: analyze Oracle 10046 SQL trace files with the mtkprof engine.",
    "copyright": "Copyright 2026 David Budac. Apache-2.0.",
    "license": "Apache-2.0",
    "externalBin": ["binaries/mtkprof-engine"],
    "fileAssociations": [
      {
        "ext": ["trc"],
        "name": "Oracle trace file",
        "description": "Oracle trace file",
        "role": "Viewer"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": false,
    "windows": {
      "nsis": { "installMode": "currentUser" }
    },
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
