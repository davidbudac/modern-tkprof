{
  "name": "mtkprof-desktop",
  "private": true,
  "version": "0.7.0",
  "description": "mtkprof desktop: Electron shell around the mtkprof engine",
  "author": "David Budac",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:app": "node scripts/dev-app.mjs",
    "build": "tsc -b && vite build && node scripts/build-electron.mjs",
    "build:electron": "node scripts/build-electron.mjs",
    "app": "pnpm build && electron .",
    "dist": "pnpm build && electron-builder",
    "typecheck": "tsc -b && tsc -p electron",
    "build:engine": "node scripts/build-engine.mjs",
    "gen:api": "openapi-typescript ../api/engine.openapi.yaml -o src/engine/api.d.ts",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "openapi-typescript": "^7.13.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
