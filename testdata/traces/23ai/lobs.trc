PARSING IN CURSOR #132139134684240 len=396 dep=1 uid=0 oct=3 lid=0 tim=31369110806 hv=2658710720 ad='7990dab0' sqlid='6bvg5d2g7jd60'
SELECT o.name FROM (SELECT :1 as obj# FROM dual UNION ALL SELECT d.d_obj# as obj# FROM dependency$ d JOIN obj$ o ON d.d_obj# = o.obj# AND o.type# = 5 START WITH d.p_obj# = :1 CONNECT BY PRIOR d.d_obj# = d.p_obj# ) bo, obj$ o, dependency$ d, jsonmap_view$ j WHERE d.p_obj# = bo.obj# AND d.d_obj# = j.obj# AND bitand(j.flags,1)=1 AND o.status NOT IN (3,5) AND o.obj# = j.obj# FETCH FIRST 1 ROW ONLY
END OF STMT
