PARSING IN CURSOR #140426397979360 len=225 dep=0 uid=165 oct=47 lid=165 tim=48393082135 hv=2470086763 ad='7b785c98' sqlid='2mcr2029mp23b'
declare
  v_n number;
begin
  for i in 1 .. 5 loop
    select /* mtk_basic_loop */ count(*) into v_n
      from mtk_orders o join mtk_cust c on c.id = o.cust_id
     where o.cust_id = i * 7 and c.amount >= 0;
  end loop;
end;
END OF STMT
