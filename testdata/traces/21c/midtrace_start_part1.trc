PARSING IN CURSOR #126291195996864 len=582 dep=0 uid=110 oct=47 lid=110 tim=31581468310 hv=4158270254 ad='6ae7b820' sqlid='430qf1bvxnatf'
declare
  cursor c_orders is
    select /* mtk_midtrace_open_cursor */ o.id, o.amount from mtk_orders o
     where o.cust_id between 1 and 30 order by o.id;
  v_id  number;
  v_amt number;
  v_n   pls_integer := 0;
  v_cnt number;
begin
  open c_orders;
  loop
    fetch c_orders into v_id, v_amt;
    exit when c_orders%notfound;
    v_n := v_n + 1;
    if v_n = 5 then
      execute immediate 'alter session set tracefile_identifier = ''mtk_midtrace_start''';
    end if;
    if mod(v_n, 50) = 0 then
      mtk_p_cached(v_id, v_cnt);
    end if;
  end loop;
  close c_orders;
end;
END OF STMT
