merge into sys.col_group_usage$ d using (select :1 obj#, :2 cols from dual) s on (d.obj# = s.obj# and d.cols = s.cols) when matched then update set d.timestamp = :3, d.flags = d.flags + :4 - bitand(d.flags, :4), d.cols_range = dbms_auto_index_internal.merge_cols_str(d.cols_range, :5) when not matched then insert (obj#, cols, timestamp, flags, cols_range) values (:1,:2,:3,:4,:5)
END OF STMT
