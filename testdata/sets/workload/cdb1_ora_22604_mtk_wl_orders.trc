PARSING IN CURSOR #139698262453424 len=291 dep=1 uid=0 oct=189 lid=0 tim=12132622046 hv=4200462351 ad='6d3e90e0' sqlid='0mqcv3mx5vy0g'
merge into sys.col_group_usage$ d using (select :1 obj#, :2 cols from dual) s on (d.obj# = s.obj# and d.cols = s.cols) when matched then update set d.timestamp = :3, d.flags = d.flags + :4 - bitand(d.flags, :4) when not matched then insert (obj#, cols, timestamp, flags) values (:1,:2,:3,:4)
END OF STMT
